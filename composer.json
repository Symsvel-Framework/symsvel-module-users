{
    "name": "symsvel-framework/module-users",
    "description": "SymSvel module Users",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^8.1",
        "doctrine/orm": "^3.3",
        "doctrine/doctrine-bundle": "^3.0",
        "symsvel-framework/module-auth": "^1.1",
        "symsvel-framework/module-mails": "^1.0",
        "symsvel-framework/module-settings": "^1.0",
        "doctrine/migrations": "^3.9",
        "symsvel-framework/module-acls": "^1.0",
        "symsvel-framework/module-languages": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SymSvel\\Module\\Users\\": "back/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymSvel\\Module\\Users\\Tests\\": "back/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "test": "phpunit -c back/phpunit.xml.dist --display-skipped",
        "qa": [
            "@test"
        ]
    },
    "extra": {
        "symsvel-module": {
            "manifest": "module.json"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-acls.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-auth.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-mails.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-settings.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-languages.git"
        },
        {
            "type": "composer",
            "url": "https://packages.xavier-tezza.fr"
        }
    ]
}
